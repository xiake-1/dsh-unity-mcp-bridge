{
  "name": "dsh-unity-mcp-bridge",
  "version": "0.6.0",
  "private": true,
  "description": "Opt-in Unity-MCP bridge for DeepSeek Harness: dormant by default, /unity-mcp-tools activates it, ships the 1.2.0 command catalog plus /unity-mcp-install and /unity-mcp-check.",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiake-1/dsh-unity-mcp-bridge.git"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "tools",
    "vendor",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "FEATURES-AND-COMPARISON.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-attachment": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-timeout": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
